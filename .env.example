# Copy to .env (gitignored) and fill in there. NEVER put real keys in this file: it is committed.
# Text provider: template (own wording from phrases.json, default) | gonka | anthropic
FEC_LLM_PROVIDER=template
# Gonka broker (OpenAI-compatible)
GONKA_BROKER_URL=https://api.gonkarouter.io/v1
GONKA_BROKER_API_KEY=
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Optional alternative
ANTHROPIC_API_KEY=
# auto = data/processed/ if teammate files exist, else data/mock/ ; or force: mock | processed
FEC_DATA_SOURCE=auto
API_URL=http://localhost:8000
